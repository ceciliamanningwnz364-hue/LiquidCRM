// MARK: - 5. КАРТОЧКА ЗВОНКА
struct CallRowCard: View {
    let call: CallRecord
    let onTap: () -> Void
    let onDelete: () -> Void
    
    var body: some View {
        Button(action: onTap) {
            VStack(alignment: .leading, spacing: 10) {
                HStack {
                    Image(systemName: call.outcome.icon)
                        .font(.system(size: 13, weight: .bold))
                        .foregroundStyle(call.outcome.color)
                        .padding(8)
                        .background(call.outcome.color.opacity(0.18))
                        .clipShape(Circle())
                    
                    VStack(alignment: .leading, spacing: 2) {
                        Text(call.name).font(.system(size: 16, weight: .bold, design: .rounded)).foregroundStyle(.white)
                        if !call.phone.isEmpty {
                            Text(call.phone).font(.system(size: 13, weight: .medium, design: .monospaced)).foregroundStyle(.cyan)
                        }
                    }
                    Spacer()
                    VStack(alignment: .trailing, spacing: 4) {
                        Text(call.outcome.rawValue)
                            .font(.system(size: 11, weight: .heavy, design: .rounded))
                            .foregroundStyle(call.outcome.color)
                            .padding(.horizontal, 10)
                            .padding(.vertical, 4)
                            .background(call.outcome.color.opacity(0.15))
                            .clipShape(Capsule())
                        Text(call.timestamp.formatted(date: .omitted, time: .shortened))
                            .font(.system(size: 11)).foregroundStyle(.white.opacity(0.4))
                    }
                }
                if !call.note.isEmpty {
                    Text(call.note)
                        .font(.system(size: 13)).foregroundStyle(.white.opacity(0.85))
                        .frame(maxWidth: .infinity, alignment: .leading)
                        .padding(10).background(Color.white.opacity(0.06))
                        .clipShape(RoundedRectangle(cornerRadius: 12, style: .continuous))
                } else {
                    Text("Нажми, чтобы добавить заметку или номер...")
                        .font(.system(size: 12)).italic().foregroundStyle(.white.opacity(0.35))
                }
            }
            .padding(16)
            .liquidGlass(cornerRadius: 20)
        }
        .buttonStyle(.plain)
    }
}

// MARK: - 6. РЕДАКТИРОВАНИЕ И ЗАМЕТКИ
struct AddOrEditCallSheet: View {
    @ObservedObject var store: CRMStore
    var existingCall: CallRecord?
    @Environment(\.dismiss) private var dismiss
    
    @State private var name: String = ""
    @State private var phone: String = ""
    @State private var note: String = ""
    @State private var outcome: CallOutcome = .talked
    
    var body: some View {
        NavigationStack {
            ZStack {
                LiquidBackground()
                ScrollView {
                    VStack(spacing: 18) {
                        HStack(spacing: 8) {
                            ForEach(CallOutcome.allCases, id: \.self) { item in
                                Button {
                                    outcome = item
                                } label: {
                                    VStack(spacing: 6) {
                                        Image(systemName: item.icon).font(.system(size: 18, weight: .bold))
                                        Text(item.rawValue).font(.system(size: 11, weight: .bold))
                                    }
                                    .foregroundStyle(outcome == item ? .black : .white)
                                    .frame(maxWidth: .infinity)
                                    .padding(.vertical, 12)
                                    .background(outcome == item ? item.color : Color.white.opacity(0.08))
                                    .clipShape(RoundedRectangle(cornerRadius: 14, style: .continuous))
                                }
                            }
                        }
                        .padding(16).liquidGlass(cornerRadius: 22)
                        
                        VStack(spacing: 14) {
                            TextField("Имя клиента / Компания", text: $name)
                                .padding(14).background(Color.white.opacity(0.08)).clipShape(RoundedRectangle(cornerRadius: 14)).foregroundStyle(.white)
                            TextField("Телефон", text: $phone).keyboardType(.phonePad)
                                .padding(14).background(Color.white.opacity(0.08)).clipShape(RoundedRectangle(cornerRadius: 14)).foregroundStyle(.white)
                            TextEditor(text: $note).scrollContentBackground(.hidden).frame(minHeight: 110)
                                .padding(10).background(Color.white.opacity(0.08)).clipShape(RoundedRectangle(cornerRadius: 14)).foregroundStyle(.white)
                        }
                        .padding(16).liquidGlass(cornerRadius: 22)
                        
                        if let existing = existingCall {
                            Button(role: .destructive) {
                                store.deleteCall(id: existing.id)
                                dismiss()
                            } label: {
                                Text("Удалить звонок").font(.system(size: 15, weight: .bold)).foregroundStyle(.red)
                                    .frame(maxWidth: .infinity).padding(.vertical, 14).liquidGlass(cornerRadius: 18)
                            }
                        }
                    }
                    .padding(16)
                }
            }
            .navigationTitle(existingCall == nil ? "Новый звонок" : "Редактировать")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .cancellationAction) { Button("Отмена") { dismiss() } }
                ToolbarItem(placement: .confirmationAction) {
                    Button("Сохранить") {
                        if var existing = existingCall {
                            existing.name = name.isEmpty ? existing.name : name
                            existing.phone = phone
                            existing.note = note
                            existing.outcome = outcome
                            store.updateCall(existing)
                        } else {
                            store.addCall(name: name, phone: phone, note: note, outcome: outcome)
                        }
                        dismiss()
                    }
                }
            }
            .onAppear {
                if let call = existingCall {
                    name = call.name; phone = call.phone; note = call.note; outcome = call.outcome
                }
            }
        }
        .preferredColorScheme(.dark)
    }
}

// MARK: - 7. НАСТРОЙКИ ЦЕЛЕЙ
struct GoalSettingsSheet: View {
    @ObservedObject var store: CRMStore
    @Environment(\.dismiss) private var dismiss
    @State private var coldGoalText: String = ""
    @State private var talkedGoalText: String = ""
    
    var body: some View {
        NavigationStack {
            ZStack {
                LiquidBackground()
                VStack(spacing: 20) {
                    VStack(alignment: .leading, spacing: 14) {
                        Text("План по холодным звонкам").foregroundStyle(.cyan)
                        TextField("120", text: $coldGoalText).keyboardType(.numberPad)
                            .padding(14).background(Color.white.opacity(0.08)).clipShape(RoundedRectangle(cornerRadius: 14)).foregroundStyle(.white)
                        Text("План по разговорным звонкам").foregroundStyle(.purple)
                        TextField("30", text: $talkedGoalText).keyboardType(.numberPad)
                            .padding(14).background(Color.white.opacity(0.08)).clipShape(RoundedRectangle(cornerRadius: 14)).foregroundStyle(.white)
                    }
                    .padding(20).liquidGlass(cornerRadius: 24)
                    
                    Button(role: .destructive) {
                        store.resetDay()
                        dismiss()
                    } label: {
                        Text("Обнулить сегодняшнюю смену").font(.system(size: 15, weight: .bold)).foregroundStyle(.red)
                            .frame(maxWidth: .infinity).padding(.vertical, 16).liquidGlass(cornerRadius: 20)
                    }
                    Spacer()
                }
                .padding(16)
            }
            .navigationTitle("Мои цели")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .confirmationAction) {
                    Button("Готово") {
                        if let c = Int(coldGoalText), c > 0 { store.coldCallGoal = c }
                        if let t = Int(talkedGoalText), t > 0 { store.talkedCallGoal = t }
                        dismiss()
                    }
                }
            }
            .onAppear {
                coldGoalText = "\(store.coldCallGoal)"
                talkedGoalText = "\(store.talkedCallGoal)"
            }
        }
        .preferredColorScheme(.dark)
    }
}
