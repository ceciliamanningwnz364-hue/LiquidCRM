// MARK: - 1. МОДЕЛИ ДАННЫХ
enum CallOutcome: String, CaseIterable, Codable {
    case noAnswer = "Недозвон"
    case talked = "Разговор"
    case lead = "Лид 🔥"
    case rejected = "Отказ"
    
    var icon: String {
        switch self {
        case .noAnswer: return "phone.down.fill"
        case .talked: return "bubble.left.and.bubble.right.fill"
        case .lead: return "flame.fill"
        case .rejected: return "xmark.circle.fill"
        }
    }
    
    var color: Color {
        switch self {
        case .noAnswer: return .gray
        case .talked: return .cyan
        case .lead: return .green
        case .rejected: return .red
        }
    }
}

struct CallRecord: Identifiable, Codable, Equatable {
    var id = UUID()
    var name: String
    var phone: String
    var note: String
    var outcome: CallOutcome
    var timestamp: Date = Date()
}

// MARK: - 2. ХРАНИЛИЩЕ И ЛОГИКА (120 FPS)
final class CRMStore: ObservableObject {
    @Published var coldCallGoal: Int {
        didSet { UserDefaults.standard.set(coldCallGoal, forKey: "coldCallGoal") }
    }
    @Published var talkedCallGoal: Int {
        didSet { UserDefaults.standard.set(talkedCallGoal, forKey: "talkedCallGoal") }
    }
    @Published var calls: [CallRecord] = [] {
        didSet { saveCalls() }
    }
    
    private let storageKey = "saved_crm_calls_v1"
    
    init() {
        let savedCold = UserDefaults.standard.integer(forKey: "coldCallGoal")
        let savedTalked = UserDefaults.standard.integer(forKey: "talkedCallGoal")
        self.coldCallGoal = savedCold == 0 ? 120 : savedCold
        self.talkedCallGoal = savedTalked == 0 ? 30 : savedTalked
        loadCalls()
    }
    
    var totalCallsToday: Int { calls.count }
    var talkedCallsToday: Int { calls.filter { $0.outcome == .talked || $0.outcome == .lead }.count }
    var leadsToday: [CallRecord] { calls.filter { $0.outcome == .lead } }
    
    var coldProgress: Double {
        guard coldCallGoal > 0 else { return 0 }
        return min(Double(totalCallsToday) / Double(coldCallGoal), 1.0)
    }
    
    var talkedProgress: Double {
        guard talkedCallGoal > 0 else { return 0 }
        return min(Double(talkedCallsToday) / Double(talkedCallGoal), 1.0)
    }
    
    func addCall(name: String, phone: String, note: String, outcome: CallOutcome) {
        let cleanName = name.trimmingCharacters(in: .whitespaces).isEmpty ? "Звонок #\(calls.count + 1)" : name
        let record = CallRecord(name: cleanName, phone: phone, note: note, outcome: outcome)
        withAnimation(.spring(response: 0.35, dampingFraction: 0.75)) {
            calls.insert(record, at: 0)
        }
        triggerHaptic(for: outcome)
    }
    
    func updateCall(_ updated: CallRecord) {
        if let idx = calls.firstIndex(where: { $0.id == updated.id }) {
            withAnimation(.spring(response: 0.3, dampingFraction: 0.8)) {
                calls[idx] = updated
            }
            UIImpactFeedbackGenerator(style: .light).impactOccurred()
        }
    }
    
    func deleteCall(id: UUID) {
        withAnimation(.spring(response: 0.3, dampingFraction: 0.8)) {
            calls.removeAll { $0.id == id }
        }
        UIImpactFeedbackGenerator(style: .rigid).impactOccurred()
    }
    
    func resetDay() {
        withAnimation(.spring(response: 0.4, dampingFraction: 0.7)) {
            calls.removeAll()
        }
        UINotificationFeedbackGenerator().notificationOccurred(.warning)
    }
    
    private func triggerHaptic(for outcome: CallOutcome) {
        switch outcome {
        case .lead: UINotificationFeedbackGenerator().notificationOccurred(.success)
        case .talked: UIImpactFeedbackGenerator(style: .heavy).impactOccurred()
        default: UIImpactFeedbackGenerator(style: .medium).impactOccurred()
        }
    }
    
    private func saveCalls() {
        if let encoded = try? JSONEncoder().encode(calls) {
            UserDefaults.standard.set(encoded, forKey: storageKey)
        }
    }
    
    private func loadCalls() {
        if let data = UserDefaults.standard.data(forKey: storageKey),
           let decoded = try? JSONDecoder().decode([CallRecord].self, from: data) {
            self.calls = decoded
        }
    }
}

// MARK: - 3. LIQUID GLASS
struct LiquidBackground: View {
    @State private var animate = false
    
    var body: some View {
        ZStack {
            Color(red: 0.03, green: 0.03, blue: 0.07).ignoresSafeArea()
            
            Circle()
                .fill(LinearGradient(colors: [.cyan.opacity(0.45), .blue.opacity(0.15)], startPoint: .topLeading, endPoint: .bottomTrailing))
                .frame(width: 320, height: 320)
                .blur(radius: 75)
                .offset(x: animate ? -70 : 70, y: animate ? -150 : -60)
            
            Circle()
                .fill(LinearGradient(colors: [.purple.opacity(0.45), .pink.opacity(0.15)], startPoint: .top, endPoint: .bottom))
                .frame(width: 300, height: 300)
                .blur(radius: 80)
                .offset(x: animate ? 80 : -60, y: animate ? 220 : 100)
            
            Circle()
                .fill(Color.green.opacity(0.2))
                .frame(width: 240, height: 240)
                .blur(radius: 90)
                .offset(x: animate ? -40 : 50, y: animate ? 50 : -120)
        }
        .ignoresSafeArea()
        .onAppear {
            withAnimation(.easeInOut(duration: 9).repeatForever(autoreverses: true)) {
                animate.toggle()
            }
        }
    }
}

struct GlassModifier: ViewModifier {
    var cornerRadius: CGFloat = 24
    
    func body(content: Content) -> some View {
        content
            .background(.ultraThinMaterial)
            .clipShape(RoundedRectangle(cornerRadius: cornerRadius, style: .continuous))
            .overlay(
                RoundedRectangle(cornerRadius: cornerRadius, style: .continuous)
                    .stroke(
                        LinearGradient(
                            colors: [.white.opacity(0.55), .white.opacity(0.12), .clear, .white.opacity(0.25)],
                            startPoint: .topLeading,
                            endPoint: .bottomTrailing
                        ),
                        lineWidth: 1.2
                    )
            )
            .shadow(color: .black.opacity(0.35), radius: 16, x: 0, y: 8)
    }
}

extension View {
    func liquidGlass(cornerRadius: CGFloat = 24) -> some View {
        self.modifier(GlassModifier(cornerRadius: cornerRadius))
    }
}

