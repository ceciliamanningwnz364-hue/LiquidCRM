    private var searchField: some View {
        HStack(spacing: 10) {
            Image(systemName: "magnifyingglass").foregroundStyle(.white.opacity(0.5))
            TextField("Поиск по имени, номеру или заметке...", text: $searchText)
                .foregroundStyle(.white)
