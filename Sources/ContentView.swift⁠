                .background(selectedTab == index ? AnyShapeStyle(LinearGradient(colors: [.cyan, .white], startPoint: .topLeading, endPoint: .bottomTrailing)) : AnyShapeStyle(Color.clear))
                .clipShape(RoundedRectangle(cornerRadius: 13, style: .continuous))
